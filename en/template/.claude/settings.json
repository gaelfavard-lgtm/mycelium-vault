{
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(xargs rm*)",
      "PowerShell(Remove-Item *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/logbook-guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/logging-notice.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
